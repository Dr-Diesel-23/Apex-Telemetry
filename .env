# ─── ApexTelemetry Backend ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL="postgresql://apex:apex@localhost:5432/apex_telemetry?schema=public"

# Redis (optional — cache gracefully degrades to in-memory when unavailable)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=false

# Upstream data
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_CACHE_TTL_SECONDS=300

# Telemetry websocket
WS_PATH="/ws/telemetry"
WS_BROADCAST_INTERVAL_MS=500

# CORS — comma separated list, or "*"
CORS_ORIGIN="*"
LOG_LEVEL="info"

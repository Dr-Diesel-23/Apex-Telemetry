NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL="postgresql://apex:apex@localhost:5432/apex_telemetry?schema=public"

REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=false

OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_CACHE_TTL_SECONDS=300

# OpenF1 — real F1 timing + car telemetry (https://api.openf1.org/v1)
OPENF1_ENABLED=true
OPENF1_BASE_URL="https://api.openf1.org/v1"
OPENF1_TIMEOUT_MS=8000
OPENF1_WINDOW_SECONDS=90

# Jolpica — F1 calendar + standings fallback (no key, https://api.jolpi.ca)
JOLPICA_ENABLED=true
JOLPICA_BASE_URL="https://api.jolpi.ca/ergast/f1"

# MotoGP Pulse Live — real MotoGP results/standings (no key)
MOTOGP_API_ENABLED=true
MOTOGP_API_BASE_URL="https://api.motogp.pulselive.com/motogp/v1"

# Stream simulated frames when no session is live (default: off — live only)
SIMULATED_TELEMETRY=false

WS_PATH="/ws/telemetry"
WS_BROADCAST_INTERVAL_MS=500

CORS_ORIGIN="*"
LOG_LEVEL="info"
